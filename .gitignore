# 编辑器
.idea
.vscode

# Python（scripts/ 与 src/ 下的缓存均忽略）
__pycache__/
*.pyc

# MD 成品 output/文案/ 必须入库，其余一律忽略。
# 不能整条忽略 output/，否则成品提交不上去；反过来也不能整条放开，
# 否则会把登录态凭证和几十 MB 音视频提交进来。
output/*
!output/文案/

# 抖音登录态（含 Cookie 凭证，切勿提交）
output/douyin/
# 下载的音视频与中间产物
output/_temp_audio/
output/_tr/
output/_trash/
output/_temp_transcript/
output/_temp_test_audio/

# 运行期本地状态（脚本生成的临时文件）
_status.txt
_realtime.json
_realtime.json.tmp
_pipeline.log
_lark_qr.png

# 一次性探针/调试产物（用完即删，勿入库）
/_probe*
/_check*

# WorkBuddy 本地工作记忆（不入库，正式内容放 docs/）
.workbuddy/

# 说明：config/ 下的 list_*.json 是输入数据，需纳入版本管理，不要忽略。
